# Copy to .env (gitignored). CI/CD writes .env per environment on the server.
# Only secrets and the environment selectors live here; all other config is fixed in the compose files.
# docker-compose.yaml requires every value; docker-compose.dev.yaml falls back to dev-only defaults.

# Environment selectors for built images (docker-compose.yaml). docker-compose.dev.yaml always runs as dev.
APP_ENV=prod
BUILD_CONFIGURATION=production

# Secrets.
POSTGRES_PASSWORD=
KC_BOOTSTRAP_ADMIN_PASSWORD=
