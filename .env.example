# Copy to .env (gitignored). CI/CD writes .env per environment on the server.
# docker-compose.yaml requires every value below; docker-compose.dev.yaml falls back to dev-only defaults.
# The frontend only gets BUILD_CONFIGURATION, because anything given to the Angular build ends up in the public bundle.

# Built-image environment (docker-compose.yaml). docker-compose.dev.yaml always runs as dev.
APP_ENV=prod
BUILD_CONFIGURATION=production

# Postgres; its single database belongs to Keycloak.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=

# Keycloak. KC_HOSTNAME is the public URL, and becomes the issuer in every token.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_HOSTNAME=https://auth.example.com
# Allowed login redirect and web origin for the frontend client in realm-app.json.
FRONTEND_URL=https://app.example.com

# Backend services verifying tokens with auth-client.
# The issuer is the public realm URL; the JWKS URI is how services reach Keycloak inside the network.
AUTH_ISSUER=https://auth.example.com/realms/app
AUTH_JWKS_URI=http://keycloak:8080/realms/app/protocol/openid-connect/certs
AUTH_AUDIENCE=api
