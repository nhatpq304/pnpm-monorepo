# Copy to .env (gitignored). CI/CD writes .env per environment on the server.
# The whole file is passed to the auth container; the frontend only gets BUILD_CONFIGURATION,
# because anything given to the Angular build ends up in the public bundle.

# Built-image environment (docker-compose.yaml).
# docker-compose.dev.yaml ignores both and always runs as dev.
APP_ENV=prod
BUILD_CONFIGURATION=production

# Secrets (tokens, keys) go below.
